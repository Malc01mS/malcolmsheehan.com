---
import readingData from '../../public/reading.json';
const books = readingData;
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Malcolm Sheehan</title>
  <meta name="description" content="Malcolm Sheehan — writing and reading." />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --text: #1c1c1a;
      --muted: #7a7a72;
      --subtle: #c8c6be;
      --bg: #f2f0ea;
    }

    html { font-size: 16px; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
      line-height: 1.6;
      min-height: 100vh;
    }

    /* Layout */
    .container {
      max-width: 580px;
      margin: 0 auto;
      padding: 80px 24px 100px;
    }

    /* Hero */
    .hero {
      margin-bottom: 80px;
      padding-bottom: 64px;
      border-bottom: 1px solid var(--subtle);
    }

    .name {
      font-family: 'EB Garamond', serif;
      font-size: 42px;
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1;
    }

    /* Sections */
    section {
      margin-bottom: 56px;
    }

    .section-label {
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 20px;
    }

    /* Writing */
    .writing-list {
      list-style: none;
    }

    .writing-list li {
      padding: 13px 0;
      border-bottom: 1px solid var(--subtle);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
    }

    .writing-list li:first-child {
      border-top: 1px solid var(--subtle);
    }

    .essay-title {
      font-family: 'EB Garamond', serif;
      font-size: 18px;
      font-weight: 400;
      color: var(--text);
      text-decoration: none;
      line-height: 1.3;
      letter-spacing: 0.01em;
      transition: opacity 0.15s;
    }

    .essay-title:hover { opacity: 0.5; }

    .essay-title:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: 2px;
      border-radius: 1px;
    }

    .essay-date {
      font-size: 11px;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
      letter-spacing: 0.04em;
    }

    /* Reading */
    .reading-list {
      list-style: none;
    }

    .reading-list li {
      font-size: 13px;
      line-height: 1.5;
      padding: 10px 0;
      border-bottom: 1px solid var(--subtle);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
      color: var(--muted);
    }

    .reading-list li:first-child {
      border-top: 1px solid var(--subtle);
    }

    .book-title {
      font-family: 'EB Garamond', serif;
      font-style: italic;
      font-size: 16px;
      color: var(--text);
    }

    .book-author {
      font-size: 12px;
      color: var(--muted);
      flex-shrink: 0;
    }

    /* Contact */
    .contact-links {
      display: flex;
      gap: 24px;
    }

    .contact-links a {
      font-size: 13px;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 1px solid var(--subtle);
      padding-bottom: 1px;
      transition: color 0.15s, border-color 0.15s;
    }

    .contact-links a:hover {
      color: var(--text);
      border-color: var(--text);
    }

    .contact-links a:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: 2px;
      border-radius: 1px;
    }

    /* Footer */
    footer {
      margin-top: 100px;
      padding-top: 24px;
      border-top: 1px solid var(--subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    footer span {
      font-size: 11px;
      color: var(--subtle);
      letter-spacing: 0.06em;
    }

    /* Skeleton */
    .skeleton {
      opacity: 0.35;
      pointer-events: none;
    }

    .skeleton-title {
      font-family: 'EB Garamond', serif;
      font-size: 18px;
      color: var(--muted);
    }

    .skeleton-date {
      font-size: 11px;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .writing-forthcoming {
      font-family: 'EB Garamond', serif;
      font-size: 18px;
      color: var(--muted);
    }

    /* Responsive */
    @media (max-width: 600px) {
      .name {
        font-size: 32px;
      }
    }
  </style>
</head>
<body>

  <main>
    <div class="container">

      <div class="hero">
        <h1 class="name">Malcolm<br />Sheehan</h1>
      </div>

      <section aria-labelledby="writing-label">
        <p class="section-label" id="writing-label">Writing</p>
        <ul class="writing-list" id="writing-list">
          <li class="skeleton"><span class="skeleton-title">Loading</span><span class="skeleton-date">— —</span></li>
          <li class="skeleton"><span class="skeleton-title">Loading</span><span class="skeleton-date">— —</span></li>
          <li class="skeleton"><span class="skeleton-title">Loading</span><span class="skeleton-date">— —</span></li>
        </ul>
      </section>

      <section aria-labelledby="reading-label">
        <p class="section-label" id="reading-label">Reading</p>
        <ul class="reading-list">
          {books.map((book) => (
            <li>
              <span class="book-title">{book.title}</span>
              <span class="book-author">{book.author}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="contact-label">
        <p class="section-label" id="contact-label">Contact</p>
        <nav class="contact-links" aria-label="Contact links">
          <a href="mailto:malcolm.sheehan@outlook.com">Email</a>
          <a href="https://www.linkedin.com/in/malcolmsheehan" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://malcolmsheehan.substack.com" target="_blank" rel="noopener noreferrer">Substack</a>
        </nav>
      </section>

      <footer role="contentinfo">
        <span>© {year}</span>
      </footer>

    </div>
  </main>

  <script>
    const list = document.getElementById('writing-list');

    function formatDate(dateStr) {
      const d = new Date(dateStr);
      return d.toLocaleString('en-US', { month: 'short', year: 'numeric' });
    }

    async function loadWriting() {
      try {
        const res = await fetch('/api/feed');
        const text = await res.text();
        const xml = new DOMParser().parseFromString(text, 'text/xml');
        const items = Array.from(xml.querySelectorAll('item')).slice(0, 6);

        if (!list) return;
        list.innerHTML = '';

        if (items.length === 0) {
          const li = document.createElement('li');
          li.className = 'writing-forthcoming';
          li.textContent = 'Essays forthcoming.';
          list.appendChild(li);
          return;
        }

        for (const item of items) {
          const title = item.querySelector('title')?.textContent ?? '';
          const link = item.querySelector('link')?.textContent ?? '#';
          const pubDate = item.querySelector('pubDate')?.textContent ?? '';
          const date = pubDate ? formatDate(pubDate) : '';

          const li = document.createElement('li');
          li.innerHTML = `
            <a href="${link}" class="essay-title" target="_blank" rel="noopener noreferrer">${title}</a>
            <span class="essay-date">${date}</span>
          `;
          list.appendChild(li);
        }
      } catch {
        if (list) list.innerHTML = '';
      }
    }

    loadWriting();
  </script>

</body>
</html>
